# Praxeos environment variables
# Copy to .env.local and fill in. .env.local is gitignored.

# === Public site config ===
NEXT_PUBLIC_SITE_URL="https://praxeos.vercel.app"
NEXT_PUBLIC_SITE_NAME="Praxeos"

# === Optional Claude Guide ===
# Server-only. When absent, the complete deterministic Guide is used.
ANTHROPIC_API_KEY=""

# === Optional privacy-preserving Guide rate limits ===
# Learner text is never written to Redis.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
GUIDE_RATE_LIMIT_SALT=""
