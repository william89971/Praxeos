{
  "name": "praxeos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Explorable explanations for Austrian economics and praxeology.",
  "author": "William Menjivar",
  "license": "MIT",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "lint:a11y": "eslint \"src/**/*.{ts,tsx}\" --no-warn-ignored",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "new-module": "tsx scripts/new-module.ts",
    "lint:modules": "tsx scripts/lint-modules.ts",
    "generate:og": "tsx scripts/generate-og-batch.ts",
    "print:manifesto": "tsx scripts/print-manifesto.ts",
    "capture:screenshots": "tsx scripts/capture-screenshots.ts",
    "eval:guide": "vitest run tests/evaluations",
    "check:links": "tsx scripts/check-links.ts",
    "lighthouse:desktop": "lhci autorun --config=.lighthouserc.json",
    "lighthouse:mobile": "lhci autorun --config=.lighthouserc.mobile.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@types/mdx": "^2.0.13",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "next": "16.2.10",
    "next-themes": "^0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remark-footnotes": "^4.0.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/fraunces": "^5.1.1",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.2",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.9.3"
  }
}
